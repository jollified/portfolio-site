{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    {
        "version": "0.2.0",
        "configurations": [
            {
                "type": "firefox",
                "request": "launch",
                "name": "Firefox: Open index.html",
                "file": "/home/deck/portfolio-site/index.html",
                "firefoxExecutable": "/usr/bin/flatpak",
                "firefoxArgs": [
                    "run",
                    "org.mozilla.firefox"
                ]
            },
            {
                "type": "firefox",
                "request": "launch",
                "name": "Firefox: http://localhost:3000",
                "url": "http://localhost:3000/index.html",
                "webRoot": "${workspaceFolder}",
                "firefoxExecutable": "/usr/bin/flatpak",
                "firefoxArgs": [
                    "run",
                    "org.mozilla.firefox"
                ]
            }
        ]
    }